# Copy to .env (gitignored) or export in your shell. Dummy placeholder values only; never commit real values.
PLM_KIT_CONFIG=/path/to/your-config.toml
PLM_KIT_CACHE=/path/to/your/cache
PLM_KIT_RERANKER=off
# Optional OneDrive source (docs/ONEDRIVE.md). Your own app registration; leave empty until you have one.
PLM_KIT_ONEDRIVE_CLIENT_ID=
PLM_KIT_ONEDRIVE_TENANT=consumers
PLM_KIT_TOKEN_CACHE=
